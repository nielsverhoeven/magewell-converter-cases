# Force LF line endings for text sources regardless of the checkout platform (this repo is
# developed on Windows and built in CI on Linux — OpenSCAD, git diffs, and the Python tooling
# all assume LF).
*.scad text eol=lf
*.py   text eol=lf
*.md   text eol=lf

# Binary/large formats — never diffed as text.
*.stl  binary
*.3mf  binary
*.pdf  binary

# Vector/CAD text formats — keep them diffable text, not binary.
*.stp  text
*.dxf  text

# cad/: the input digest of the Fusion pipeline hashes these, so they must not differ between
# a Windows checkout (autocrlf) and Linux CI (issue #76, F76.10).
cad/**/*.csv  text eol=lf
cad/**/*.json text eol=lf
cad/exports.ref text eol=lf
cad/oracle.pin  text eol=lf

# Workflows: machine-checked YAML, LF on every checkout (issue #80).
.github/workflows/*.yml text eol=lf
